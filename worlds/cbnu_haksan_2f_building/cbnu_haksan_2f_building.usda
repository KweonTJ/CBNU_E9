                        double size = 1
                        double3 xformOp:scale = (4.85, 0.025, 2.82)
                        double3 xformOp:translate = (-4.725, 0, 1.5)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    }

