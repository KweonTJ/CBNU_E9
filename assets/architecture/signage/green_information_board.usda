            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Sphere "Wheel_FL" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </GreenInformationBoard/WheelRubberMaterial>
            double radius = 0.045
            double3 xformOp:translate = (-0.25, -0.125, 0.045)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "Wheel_FR" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </GreenInformationBoard/WheelRubberMaterial>
            double radius = 0.045
            double3 xformOp:translate = (0.25, -0.125, 0.045)
            uniform token[] xformOpOrder = ["xformOp:translate"]
