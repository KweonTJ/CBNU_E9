        }

        def Cube "InfoBlock" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </GreenInformationBoard/NoticeInkMaterial>
            double size = 1
            double3 xformOp:scale = (0.11, 0.008, 0.11)
            double3 xformOp:translate = (-0.155, -0.0455, 1.03)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "RollingBase"
    {
        def Cube "LeftPost" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
