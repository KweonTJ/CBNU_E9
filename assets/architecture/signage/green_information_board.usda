#usda 1.0
(
    defaultPrim = "GreenInformationBoard"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "GreenInformationBoard" (
    kind = "component"
)
{
    custom string cbnu:architectureType = "mobile green information board"
    custom bool cbnu:collisionEnabled = true
    custom string cbnu:facing = "-Y"
    custom double3 cbnu:overallSize = (0.72, 0.34, 1.55)
    custom string cbnu:referenceStyle = "three wheeled green corridor notice boards"

    def Material "GreenBoardMaterial"
    {
        token outputs:surface.connect = </GreenInformationBoard/GreenBoardMaterial/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.035, 0.28, 0.14)
            float inputs:metallic = 0
            float inputs:roughness = 0.52
            token outputs:surface
        }
    }

    def Material "FrameMetalMaterial"
    {
        token outputs:surface.connect = </GreenInformationBoard/FrameMetalMaterial/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.57, 0.61, 0.58)
            float inputs:metallic = 0.72
            float inputs:roughness = 0.30
            token outputs:surface
        }
    }

    def Material "NoticePaperMaterial"
    {
        token outputs:surface.connect = </GreenInformationBoard/NoticePaperMaterial/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.88, 0.89, 0.82)
            float inputs:metallic = 0
            float inputs:roughness = 0.76
            token outputs:surface
        }
    }

    def Material "NoticeInkMaterial"
    {
        token outputs:surface.connect = </GreenInformationBoard/NoticeInkMaterial/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.08, 0.11, 0.10)
            float inputs:metallic = 0
            float inputs:roughness = 0.62
            token outputs:surface
        }
    }

    def Material "WheelRubberMaterial"
    {
        token outputs:surface.connect = </GreenInformationBoard/WheelRubberMaterial/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.025, 0.03, 0.028)
            float inputs:metallic = 0
            float inputs:roughness = 0.70
            token outputs:surface
        }
    }

    def Cube "PanelBacking" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </GreenInformationBoard/GreenBoardMaterial>
        bool physics:collisionEnabled = true
        double size = 1
        double3 xformOp:scale = (0.63, 0.055, 1.20)
        double3 xformOp:translate = (0, 0, 0.885)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Frame"
    {
        def Cube "TopRail" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </GreenInformationBoard/FrameMetalMaterial>
            double size = 1
            double3 xformOp:scale = (0.72, 0.07, 0.045)
            double3 xformOp:translate = (0, 0, 1.5275)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "BottomRail" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </GreenInformationBoard/FrameMetalMaterial>
            double size = 1
            double3 xformOp:scale = (0.72, 0.07, 0.045)
            double3 xformOp:translate = (0, 0, 0.2425)
