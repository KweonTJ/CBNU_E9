            double size = 1
            double3 xformOp:scale = (0.045, 0.07, 1.33)
            double3 xformOp:translate = (0.3375, 0, 0.885)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "NoticeFace"
    {
        def Cube "NoticeSheet" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </GreenInformationBoard/NoticePaperMaterial>
