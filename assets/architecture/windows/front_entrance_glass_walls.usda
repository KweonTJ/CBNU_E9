#usda 1.0
(
    defaultPrim = "FrontEntranceGlassWalls"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FrontEntranceGlassWalls" (
    kind = "component"
)
{
    custom bool cbnu:collisionEnabled = false
    custom int cbnu:fullHeightGlassPanelCount = 2
    custom string cbnu:glassFinish = "clear architectural glass"
    custom bool cbnu:perimeterGapsClosed = true
    custom string cbnu:perimeterJoinPolicy = "frames continuously meet side walls and entrance pillars"
    custom string cbnu:placement = "both sides of the south double-glass entrance"
    custom double cbnu:doorOpeningWidth = 4.6
    custom double2 cbnu:eachGlassPanelSize = (4.85, 2.82)
    custom int cbnu:lowerFacadeWallPanelCount = 2
    custom double cbnu:lowerFacadeWallHeight = 1.02
    custom double3 cbnu:leftLowerFacadeWallSize = (5.4055, 0.20, 1.02)
    custom double3 cbnu:rightLowerFacadeWallSize = (5.1736, 0.20, 1.02)
    custom double2 cbnu:lowerFacadeDoorClearSpan = (21.42, 25.58)
    custom string cbnu:lowerFacadeWallPlacement = "full facade spans from side-wall centerlines to the glass-door frame, flush with the visible entrance-pillar south plane"

    def Material "GlassMaterial"
    {
        token outputs:surface.connect = </FrontEntranceGlassWalls/GlassMaterial/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.48, 0.73, 0.78)
            float inputs:ior = 1.5
            float inputs:metallic = 0
            float inputs:opacity = 0.13
            float inputs:opacityThreshold = 0
            float inputs:roughness = 0.08
            token outputs:surface
        }
    }

    def Material "FrameMaterial"
    {
        token outputs:surface.connect = </FrontEntranceGlassWalls/FrameMaterial/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.14, 0.16, 0.17)
            float inputs:metallic = 0.72
            float inputs:roughness = 0.28
            token outputs:surface
        }
    }

    def Material "LowerFacadeWallMaterial" (
        prepend references = @../../materials/lobby/wall_column_light_gray.usda@
    )
    {
    }

    def Xform "LeftFullHeightGlass"
    {
        custom string cbnu:side = "left of entrance"

        def Cube "GlassPanel"
        {
            rel material:binding = </FrontEntranceGlassWalls/GlassMaterial>
            double size = 1
            double3 xformOp:scale = (4.85, 0.025, 2.82)
            double3 xformOp:translate = (-4.725, 0, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "LowerOpaqueWall" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </FrontEntranceGlassWalls/LowerFacadeWallMaterial>
            double size = 1
            double3 xformOp:scale = (5.4055, 0.20, 1.02)
            double3 xformOp:translate = (-4.78275, -0.08, 0.51)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "OuterFrame"
        {
            rel material:binding = </FrontEntranceGlassWalls/FrameMaterial>
            double size = 1
            double3 xformOp:scale = (0.2355, 0.060, 3.0)
            double3 xformOp:translate = (-7.26775, 0, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "DoorSideFrame"
        {
            rel material:binding = </FrontEntranceGlassWalls/FrameMaterial>
            double size = 1
            double3 xformOp:scale = (0.22, 0.060, 3.0)
            double3 xformOp:translate = (-2.19, 0, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "BottomFrame"
        {
            rel material:binding = </FrontEntranceGlassWalls/FrameMaterial>
            double size = 1
            double3 xformOp:scale = (4.85, 0.060, 0.10)
            double3 xformOp:translate = (-4.725, 0, 0.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "TopFrame"
        {
            rel material:binding = </FrontEntranceGlassWalls/FrameMaterial>
            double size = 1
            double3 xformOp:scale = (4.85, 0.060, 0.10)
            double3 xformOp:translate = (-4.725, 0, 2.95)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "RightFullHeightGlass"
    {
        custom string cbnu:side = "right of entrance"

        def Cube "GlassPanel"
        {
            rel material:binding = </FrontEntranceGlassWalls/GlassMaterial>
            double size = 1
            double3 xformOp:scale = (4.85, 0.025, 2.82)
            double3 xformOp:translate = (4.725, 0, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "LowerOpaqueWall" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </FrontEntranceGlassWalls/LowerFacadeWallMaterial>
            double size = 1
            double3 xformOp:scale = (5.1736, 0.20, 1.02)
            double3 xformOp:translate = (4.6668, -0.08, 0.51)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "DoorSideFrame"
        {
            rel material:binding = </FrontEntranceGlassWalls/FrameMaterial>
            double size = 1
            double3 xformOp:scale = (0.22, 0.060, 3.0)
            double3 xformOp:translate = (2.19, 0, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "OuterFrame"
        {
            rel material:binding = </FrontEntranceGlassWalls/FrameMaterial>
            double size = 1
            double3 xformOp:scale = (0.10, 0.060, 3.0)
            double3 xformOp:translate = (7.20, 0, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "BottomFrame"
        {
            rel material:binding = </FrontEntranceGlassWalls/FrameMaterial>
            double size = 1
            double3 xformOp:scale = (4.85, 0.060, 0.10)
            double3 xformOp:translate = (4.725, 0, 0.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "TopFrame"
        {
            rel material:binding = </FrontEntranceGlassWalls/FrameMaterial>
            double size = 1
            double3 xformOp:scale = (4.85, 0.060, 0.10)
            double3 xformOp:translate = (4.725, 0, 2.95)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}
