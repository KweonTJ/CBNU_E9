#usda 1.0
(
    defaultPrim = "WoodDoorSingle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "WoodDoorSingle" (
    kind = "component"
)
{
    custom bool cbnu:collisionEnabled = false
    custom int cbnu:doorLeafCount = 1
    custom string cbnu:purpose = "decorative static corridor door"

    def Scope "Materials"
    {
        def Material "Wood"
        {
            token outputs:surface.connect = </WoodDoorSingle/Materials/Wood/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34, 0.12, 0.035)
                float inputs:metallic = 0
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "WoodAccent"
        {
            token outputs:surface.connect = </WoodDoorSingle/Materials/WoodAccent/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.46, 0.205, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }

        def Material "DarkWood"
        {
            token outputs:surface.connect = </WoodDoorSingle/Materials/DarkWood/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.19, 0.052, 0.012)
                float inputs:metallic = 0
                float inputs:roughness = 0.44
                token outputs:surface
            }
        }

        def Material "HandleMetal"
        {
            token outputs:surface.connect = </WoodDoorSingle/Materials/HandleMetal/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.27, 0.07)
                float inputs:metallic = 0.75
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }
    }

    def Xform "Frame"
    {
        def Cube "LeftJamb"
        {
            rel material:binding = </WoodDoorSingle/Materials/DarkWood>
            double size = 1
            double3 xformOp:scale = (0.08, 0.10, 2.20)
            double3 xformOp:translate = (-0.49, 0, 1.10)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "RightJamb"
        {
            rel material:binding = </WoodDoorSingle/Materials/DarkWood>
            double size = 1
            double3 xformOp:scale = (0.08, 0.10, 2.20)
            double3 xformOp:translate = (0.49, 0, 1.10)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Header"
        {
            rel material:binding = </WoodDoorSingle/Materials/DarkWood>
            double size = 1
            double3 xformOp:scale = (1.06, 0.10, 0.10)
            double3 xformOp:translate = (0, 0, 2.15)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "DoorLeaf"
    {
        def Cube "Slab"
        {
            rel material:binding = </WoodDoorSingle/Materials/Wood>
            double size = 1
            double3 xformOp:scale = (0.90, 0.045, 2.10)
            double3 xformOp:translate = (0, 0, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "UpperPanelFront"
        {
            rel material:binding = </WoodDoorSingle/Materials/WoodAccent>
            double size = 1
            double3 xformOp:scale = (0.62, 0.018, 0.62)
            double3 xformOp:translate = (0, -0.031, 1.49)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "LowerPanelFront"
        {
            rel material:binding = </WoodDoorSingle/Materials/WoodAccent>
            double size = 1
            double3 xformOp:scale = (0.62, 0.018, 0.54)
            double3 xformOp:translate = (0, -0.031, 0.63)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "UpperPanelBack"
        {
            rel material:binding = </WoodDoorSingle/Materials/WoodAccent>
            double size = 1
            double3 xformOp:scale = (0.62, 0.018, 0.62)
            double3 xformOp:translate = (0, 0.031, 1.49)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "LowerPanelBack"
        {
            rel material:binding = </WoodDoorSingle/Materials/WoodAccent>
            double size = 1
            double3 xformOp:scale = (0.62, 0.018, 0.54)
            double3 xformOp:translate = (0, 0.031, 0.63)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Sphere "HandleFront"
        {
            rel material:binding = </WoodDoorSingle/Materials/HandleMetal>
            double radius = 0.04
            double3 xformOp:translate = (0.31, -0.072, 1.02)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "HandleBack"
        {
            rel material:binding = </WoodDoorSingle/Materials/HandleMetal>
            double radius = 0.04
            double3 xformOp:translate = (0.31, 0.072, 1.02)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
