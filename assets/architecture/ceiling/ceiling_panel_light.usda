#usda 1.0
(
    defaultPrim = "CeilingPanelLight"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "CeilingPanelLight" (
    kind = "component"
)
{
    custom bool cbnu:collisionEnabled = false
    custom string cbnu:fixtureType = "recessed rectangular LED ceiling panel"
    custom string cbnu:lightDirection = "local -Z"

    def Material "HousingMaterial"
    {
        token outputs:surface.connect = </CeilingPanelLight/HousingMaterial/PreviewSurface.outputs:surface>
        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.68, 0.69, 0.67)
            float inputs:metallic = 0.35
            float inputs:roughness = 0.42
            token outputs:surface
        }
    }

    def Material "DiffuserMaterial"
    {
        token outputs:surface.connect = </CeilingPanelLight/DiffuserMaterial/PreviewSurface.outputs:surface>
        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.96, 0.94, 0.86)
            color3f inputs:emissiveColor = (1.0, 0.94, 0.78)
            float inputs:roughness = 0.32
            token outputs:surface
        }
    }

    def Cube "Housing"
    {
        rel material:binding = </CeilingPanelLight/HousingMaterial>
        double size = 1
        double3 xformOp:scale = (1.30, 0.36, 0.040)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Diffuser"
    {
        rel material:binding = </CeilingPanelLight/DiffuserMaterial>
        double size = 1
        double3 xformOp:scale = (1.20, 0.30, 0.015)
        double3 xformOp:translate = (0, 0, -0.026)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def RectLight "Light"
    {
        color3f inputs:color = (1.0, 0.94, 0.82)
        float inputs:exposure = 0
        float inputs:height = 0.30
        float inputs:intensity = 8000
        bool inputs:normalize = true
        float inputs:width = 1.20
        double3 xformOp:translate = (0, 0, -0.045)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
