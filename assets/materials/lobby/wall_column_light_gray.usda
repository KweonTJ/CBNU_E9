#usda 1.0
(
    defaultPrim = "WallColumnLightGray"
    metersPerUnit = 1
    upAxis = "Z"
)

def Material "WallColumnLightGray"
{
    custom string cbnu:finish = "medium neutral gray matte wall and column finish"
    custom string cbnu:colorAdjustment = "medium gray chosen to separate the light poster and dark-gray poster"
    token outputs:surface.connect = </WallColumnLightGray/PreviewSurface.outputs:surface>

    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.56, 0.57, 0.56)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.68
        token outputs:surface
    }
}
