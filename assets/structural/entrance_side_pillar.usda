#usda 1.0
(
    defaultPrim = "EntranceSidePillar"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "EntranceSidePillar" (
    kind = "component"
)
{
    custom bool cbnu:collisionEnabled = false
    custom string cbnu:structuralType = "full-height entrance side pillar"
    custom string cbnu:finish = "warm gray stone-clad lobby pillar"
    custom double3 cbnu:size = (1.0425, 1.0, 3.0)
    custom string cbnu:depthPlacement = "back face aligned to south wall; projects 1.0 m into lobby"

    def Material "StoneCladding"
    {
        token outputs:surface.connect = </EntranceSidePillar/StoneCladding/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.48, 0.49, 0.47)
            float inputs:metallic = 0
            float inputs:roughness = 0.55
            token outputs:surface
        }
    }

    def Cube "Body"
    {
        rel material:binding = </EntranceSidePillar/StoneCladding>
        double size = 1
        double3 xformOp:scale = (1.0425, 1.0, 3.0)
        double3 xformOp:translate = (0, 0, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
