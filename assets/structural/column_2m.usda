#usda 1.0
(
    defaultPrim = "Column"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Column"
{
    def Scope "Materials"
    {
        def Material "LightConcrete"
        {
            token outputs:surface.connect = </Column/Materials/LightConcrete/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68, 0.69, 0.68)
                float inputs:metallic = 0
                float inputs:roughness = 0.58
                token outputs:surface
            }
        }
    }

    def Cube "Body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        bool physics:collisionEnabled = true
        rel material:binding = </Column/Materials/LightConcrete>
        float3[] primvars:displayColor = [(0.45, 0.45, 0.50)]
        double3 xformOp:translate = (0, 0, 1.5)
        double3 xformOp:scale = (2.0, 2.0, 3.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
