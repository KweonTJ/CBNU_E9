        rel material:binding = </ATM/Materials/ATMTrim>
        double size = 1
        double3 xformOp:scale = (0.56, 0.035, 0.30)
        double3 xformOp:translate = (0, -0.292, 0.30)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Key_1"
    {
        rel material:binding = </ATM/Materials/ButtonLight>
        double size = 1
        double3 xformOp:scale = (0.045, 0.020, 0.032)
        double3 xformOp:translate = (-0.195, -0.501, 0.965)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Key_2"
    {
        rel material:binding = </ATM/Materials/ButtonLight>
        double size = 1
        double3 xformOp:scale = (0.045, 0.020, 0.032)
        double3 xformOp:translate = (-0.140, -0.501, 0.965)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Key_3"
    {
        rel material:binding = </ATM/Materials/ButtonLight>
        double size = 1
        double3 xformOp:scale = (0.045, 0.020, 0.032)
        double3 xformOp:translate = (-0.085, -0.501, 0.965)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Key_4"
    {
        rel material:binding = </ATM/Materials/ButtonLight>
        double size = 1
        double3 xformOp:scale = (0.045, 0.020, 0.032)
        double3 xformOp:translate = (-0.195, -0.501, 0.915)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Key_5"
    {
        rel material:binding = </ATM/Materials/ButtonLight>
        double size = 1
        double3 xformOp:scale = (0.045, 0.020, 0.032)
        double3 xformOp:translate = (-0.140, -0.501, 0.915)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Key_6"
    {
        rel material:binding = </ATM/Materials/ButtonLight>
        double size = 1
        double3 xformOp:scale = (0.045, 0.020, 0.032)
        double3 xformOp:translate = (-0.085, -0.501, 0.915)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Key_7"
    {
        rel material:binding = </ATM/Materials/ButtonLight>
        double size = 1
        double3 xformOp:scale = (0.045, 0.020, 0.032)
        double3 xformOp:translate = (-0.195, -0.501, 0.865)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Key_8"
    {
        rel material:binding = </ATM/Materials/ButtonLight>
        double size = 1
        double3 xformOp:scale = (0.045, 0.020, 0.032)
        double3 xformOp:translate = (-0.140, -0.501, 0.865)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
