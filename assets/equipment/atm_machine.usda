        double3 xformOp:translate = (0.22, -0.474, 0.96)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ReceiptSlot"
    {
        rel material:binding = </ATM/Materials/SlotBlack>
        double size = 1
        double3 xformOp:scale = (0.18, 0.035, 0.035)
        double3 xformOp:translate = (0.22, -0.474, 0.86)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "CashBezel"
    {
        rel material:binding = </ATM/Materials/ATMTrim>
        double size = 1
        double3 xformOp:scale = (0.52, 0.055, 0.20)
        double3 xformOp:translate = (0, -0.305, 0.61)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "CashSlot"
    {
        rel material:binding = </ATM/Materials/SlotBlack>
        double size = 1
        double3 xformOp:scale = (0.38, 0.035, 0.070)
        double3 xformOp:translate = (0, -0.350, 0.62)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "AccessPanel"
