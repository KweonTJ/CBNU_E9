def Xform "SofaCorner" (
    kind = "component"
)
{
    custom string cbnu:furnitureType = "continuous armless L-shaped brown leather bench sofa"
    custom bool cbnu:hasArmrests = false
    custom bool cbnu:continuousJunctions = true
