#usda 1.0
(
    defaultPrim = "SofaU"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SofaU" (
    kind = "component"
)
{
    custom string cbnu:furnitureType = "continuous armless open-top U-shaped brown leather cushion sofa"
    custom bool cbnu:hasArmrests = false
    custom bool cbnu:continuousJunctions = true
    custom string cbnu:opening = "local +Y"
    custom string cbnu:seatDirection = "outward from Column_02"
    custom string cbnu:surfaceConstruction = "single unified base, seat and back meshes"
    custom string cbnu:cushionStyle = "soft overstuffed rounded cushions over unified junctions"
    custom double cbnu:columnClearance = 0

    def Scope "Materials" (
        prepend references = @../materials/furniture/brown_sofa_material.usda@
