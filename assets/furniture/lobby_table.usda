#usda 1.0
(
    defaultPrim = "LobbyTable"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "LobbyTable" (
    kind = "component"
)
{
    custom string cbnu:furnitureType = "sofa-width lobby table"
    custom double cbnu:nominalWidth = 2
    custom double cbnu:depth = 1.36
    custom double cbnu:height = 0.64

    def Scope "Materials"
    {
        def Material "TableWood"
        {
            token outputs:surface.connect = </LobbyTable/Materials/TableWood/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.24, 0.105, 0.045)
                float inputs:metallic = 0
                float inputs:roughness = 0.34
                float inputs:clearcoat = 0.08
                token outputs:surface
            }
        }

        def Material "DarkMetal"
        {
            token outputs:surface.connect = </LobbyTable/Materials/DarkMetal/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.050, 0.055)
                float inputs:metallic = 0.72
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }
    }

    def Cube "Tabletop" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </LobbyTable/Materials/TableWood>
        bool physics:collisionEnabled = true
        double size = 1
        double3 xformOp:scale = (2.0, 1.36, 0.07)
        double3 xformOp:translate = (0, 0, 0.605)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ApronLongFront"
    {
        rel material:binding = </LobbyTable/Materials/TableWood>
        double size = 1
        double3 xformOp:scale = (1.82, 0.055, 0.13)
        double3 xformOp:translate = (0, -0.605, 0.52)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ApronLongBack"
    {
        rel material:binding = </LobbyTable/Materials/TableWood>
        double size = 1
        double3 xformOp:scale = (1.82, 0.055, 0.13)
        double3 xformOp:translate = (0, 0.605, 0.52)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "LegFrontLeft"
    {
        rel material:binding = </LobbyTable/Materials/DarkMetal>
        double size = 1
        double3 xformOp:scale = (0.07, 0.07, 0.54)
        double3 xformOp:translate = (-0.82, -0.585, 0.27)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "LegFrontRight"
    {
        rel material:binding = </LobbyTable/Materials/DarkMetal>
        double size = 1
        double3 xformOp:scale = (0.07, 0.07, 0.54)
        double3 xformOp:translate = (0.82, -0.585, 0.27)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "LegBackLeft"
    {
        rel material:binding = </LobbyTable/Materials/DarkMetal>
        double size = 1
        double3 xformOp:scale = (0.07, 0.07, 0.54)
        double3 xformOp:translate = (-0.82, 0.585, 0.27)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "LegBackRight"
    {
        rel material:binding = </LobbyTable/Materials/DarkMetal>
        double size = 1
        double3 xformOp:scale = (0.07, 0.07, 0.54)
        double3 xformOp:translate = (0.82, 0.585, 0.27)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
